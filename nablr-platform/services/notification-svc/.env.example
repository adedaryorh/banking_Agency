APP_ENV=local
NOTIFICATION_HTTP_ADDRESS=:8004
NOTIFICATION_GRPC_ADDRESS=:9004
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nabla_notification?sslmode=disable

RABBITMQ_URL=
# Shared RabbitMQ broker. Docker Compose: amqp://nabla:nabla123@rabbitmq:5672/

OTEL_EXPORTER_OTLP_ENDPOINT=
# OTLP/HTTP collector endpoint. Leave empty to disable trace and metric export.

# Email provider rule:
# - mailgun: default for sandbox/staging/production.
# - smtp: optional generic SMTP provider when SMTP credentials are provided.
# - sendgrid: optional API-based fallback.
# - log: local/dev only.
EMAIL_PROVIDERS=mailgun
EMAIL_FROM_ADDRESS=noreply@nablr.com
EMAIL_FROM_NAME=Nablr
MAILGUN_BASE_URL=https://api.mailgun.net
MAILGUN_DOMAIN=
MAILGUN_API_KEY=

# Optional SMTP provider. Only used when EMAIL_PROVIDERS=smtp.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_ENCRYPTION=tls

# Optional SendGrid fallback. Only used when EMAIL_PROVIDERS includes sendgrid.
SENDGRID_BASE_URL=https://api.sendgrid.com
SENDGRID_API_KEY=

# Use log locally. Production options: digitalpulse, termii, or twilio.
SMS_PROVIDER=log
DIGITALPULSE_BASE_URL=https://mps-00.digitalpulseapi.net
DIGITALPULSE_API_KEY=
DIGITALPULSE_ROUTE=anq
TERMII_BASE_URL=https://v4.api.termii.com
TERMII_API_KEY=
SMS_SENDER_ID=
TWILIO_BASE_URL=https://api.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Use log locally. Production option: firebase.
PUSH_PROVIDER=log
# Paste the Firebase service account JSON directly here if your deploy platform supports it.
FIREBASE_CONFIG_JSON=
# Or use one of these alternatives instead.
FIREBASE_CREDENTIALS_BASE64=
FIREBASE_CREDENTIALS_PATH=

INTERNAL_SERVICE_TOKEN=
