# =============================================================================
# IDENTITY SERVICE - ENVIRONMENT CONFIGURATION
# =============================================================================


# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
IDENTITY_HTTP_ADDRESS=:
# HTTP server listen address (default: :8001)

IDENTITY_GRPC_ADDRESS=:
# gRPC server listen address for internal service-to-service communication

DATABASE_URL=postgres://postgres:postgres@localhost:5432/nablr_identity?sslmode=disable
# PostgreSQL connection string
# Format: postgres://username:password@host:port/database?options

REDIS_URL=localhost:6379
# Redis connection string for caching and rate limiting
# Format: host:port or redis://host:port

RABBITMQ_URL=
# RabbitMQ AMQP URL used by the transactional outbox relay.
# Local Docker Compose: amqp://nabla:nabla123@rabbitmq:5672/
# Leave empty to disable publishing while retaining events in PostgreSQL.


JWT_SECRET=change-this-development-jwt-secret-before-use
# Secret key for signing JWT tokens (CHANGE IN PRODUCTION!)
# Generate with: openssl rand -base64 32

JWT_ISSUER=nabla
# JWT issuer identifier (optional, defaults to "nabla")

ENCRYPTION_KEY=
# 32-byte encryption key for sensitive data (64 hex characters)
# Generate with: openssl rand -hex 32

INTERNAL_SERVICE_TOKEN=
# Token for internal service-to-service authentication
# Must match notification-svc/.env value
# Generate with: openssl rand -hex 32

API_SECRET=
# Authenticates bidirectional Identity <-> Transfers gRPC calls.
# Must match transfers-svc API_SECRET.

TRANSFERS_GRPC_URL=localhost:9002
# Docker/sandbox private-network example: transfers-svc:9002

OTEL_EXPORTER_OTLP_ENDPOINT=
# OTLP/HTTP collector endpoint, for example http://otel-collector:4318.
# Leave empty to disable trace and metric export.


SMS_PROVIDER=log
# Options: log (console), termii
# Use "log" for development, "termii" for production

TERMII_BASE_URL=https://v4.api.termii.com
# Termii API base URL

TERMII_API_KEY=your_termii_api_key_here
# Termii API key (get from https://termii.com)

SMS_SENDER_ID=Nabla
# SMS sender name (max 11 characters)

DEFAULT_OTP_CODE=000000
# Temporary testing bypass. The OTP challenge token must still be valid.
# Set DISABLE_DEFAULT_OTP=true before production.

DISABLE_DEFAULT_OTP=false

# -----------------------------------------------------------------------------
# Object Storage
# -----------------------------------------------------------------------------
OBJECT_STORAGE_PROVIDER=local
# local stores uploaded KYC documents on the server filesystem.
# s3 stores uploaded KYC documents in AWS/S3-compatible object storage.

DOCUMENT_STORAGE_PATH=./data/documents
# Local filesystem path used when OBJECT_STORAGE_PROVIDER=local.
# Sandbox example: /var/www/ident_storage/data/documents

OBJECT_STORAGE_REGION=us-east-1
# AWS region or S3-compatible region

OBJECT_STORAGE_BUCKET=nabla-identity-documents
# S3 bucket name for storing KYC documents

OBJECT_STORAGE_ENDPOINT=
# S3 endpoint URL (leave empty for AWS S3, set for other providers like MinIO)
# Example: http://localhost:9000

OBJECT_STORAGE_ACCESS_KEY_ID=
# S3 access key ID

OBJECT_STORAGE_SECRET_ACCESS_KEY=
# S3 secret access key

OBJECT_STORAGE_FORCE_PATH_STYLE=false
# Use path-style URLs (true for MinIO, false for AWS S3)


FRONTEND_URL=http://localhost:3000
# Frontend application URL for email verification links and password reset


NOTIFICATION_HTTP_URL=http://localhost:8004
# Notification service HTTP URL for delegated SMS/email delivery
# When set, identity service delegates delivery to notification service


# --- SwiftEnd (BVN/NIN Directory Lookup) ---
SWIFTEND_BASE_URL=https://swiftend.com
# SwiftEnd API base URL

SWIFTEND_SERVICE_ID=your_swiftend_service_id_here
# SwiftEnd service ID (get from SwiftEnd)

# --- Dojah (Alternative BVN Provider) ---
DOJAH_BASE_URL=https://api.dojah.io
# Dojah API base URL

DOJAH_APP_ID=your_dojah_app_id_here
# Dojah application ID

DOJAH_SECRET_KEY=your_dojah_secret_key_here
# Dojah secret key

# --- BVN Provider Configuration ---
BVN_PROVIDERS=swiftend,dojah
# Comma-separated list of BVN providers to use
# First provider is primary, others are fallback

BVN_FAILOVER=true
# Enable automatic failover to next provider if primary fails

# --- NinAuth (NIN Verification with Liveness) ---
NINAUTH_BASE_URL=
# NinAuth API base URL (optional)

NINAUTH_API_KEY=
# NinAuth API key (optional)

# --- FaceDedup (Biometric KYC - Primary for Liveness) ---
USE_FACEDEDUP=false
# Enable FaceDedup biometric verification (true/false)

FACEDEDUP_BASE_URL=https://facededup.ai
# FaceDedup API base URL

FACEDEDUP_TENANT_ID=nablr
# FaceDedup tenant ID/display tenant for this integration

FACEDEDUP_LICENSE_KEY=
# FaceDedup license key. Sent to FaceDedup as X-License-Key. REQUIRED if USE_FACEDEDUP=true.

FACEDEDUP_LIVENESS_PRIVATE_KEY_PEM=
# Optional backend-only RSA private key PEM for decrypting encrypted_liveness_payload.
# Do not commit real private keys. Prefer server secret manager/env injection.

FACEDEDUP_MOCK_NIN_VERIFY=false
# Sandbox/dev only. When true, /api/v1/onboarding/nin returns a successful mocked FaceDedup result.
# This is ignored in production.

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Comma-separated list of allowed origins for CORS

# -----------------------------------------------------------------------------
# Mobile App Versioning
# -----------------------------------------------------------------------------
MOBILE_LATEST_VERSION=1.0.0
MOBILE_MIN_SUPPORTED_VERSION=1.0.0
MOBILE_UPDATE_MESSAGE=A newer version is available.
MOBILE_IOS_LATEST_VERSION=1.0.0
MOBILE_IOS_MIN_SUPPORTED_VERSION=1.0.0
MOBILE_IOS_STORE_URL=
MOBILE_ANDROID_LATEST_VERSION=1.0.0
MOBILE_ANDROID_MIN_SUPPORTED_VERSION=1.0.0
MOBILE_ANDROID_STORE_URL=

# -----------------------------------------------------------------------------
# Admin API (operator-only raw SQL)
# -----------------------------------------------------------------------------
ADMIN_API_KEY=
# Gates POST /admin/db/query, checked as the X-Admin-Api-Key header.
# Left empty, the route refuses every request. Must match the ADMIN_API_KEY
# configured on api-gateway, which proxies to this endpoint.

# =============================================================================
# NOTES
# =============================================================================
#
# 1. SECURITY:
#    - Never commit real credentials to version control
#    - Use different secrets for each environment
#    - Rotate secrets regularly
#    - Use strong, randomly generated secrets
#
# 2. PROVIDERS:
#    - SwiftEnd: Directory lookup for BVN/NIN (basic data)
#    - FaceDedup: Biometric verification (liveness + face matching)
#    - Dojah: Alternative BVN provider (failover)
#    - NinAuth: NIN verification with liveness (optional)
#
# 3. BIOMETRIC KYC:
#    - Set USE_FACEDEDUP=true for biometric verification
#    - Requires FACEDEDUP_LICENSE_KEY from FaceDedup
#    - Enables /api/v1/onboarding/nin for mobile onboarding liveness
#    - BVN onboarding is disabled because the mobile onboarding flow has no BVN screen
#
# 4. GRPC:
#    - gRPC server runs on IDENTITY_GRPC_ADDRESS
#    - Used for internal service-to-service communication
#    - Requires INTERNAL_SERVICE_TOKEN for authentication
#
# 5. OBJECT STORAGE:
#    - Required for Tier 3 KYC document uploads
#    - Supports AWS S3 and S3-compatible providers (MinIO, DigitalOcean Spaces, etc.)
#
# 6. GENERATE SECRETS:
#    - JWT_SECRET: openssl rand -base64 32
#    - ENCRYPTION_KEY: openssl rand -hex 32
#    - INTERNAL_SERVICE_TOKEN: openssl rand -hex 32
#
