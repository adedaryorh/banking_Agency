# transfers-svc configuration
# Every variable below is actually read by internal/config/config.go or
# internal/platform/crypto/env.go. Nothing here is aspirational — if you add a
# variable, add the code that reads it in the same change.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Must match init-databases.sql / docker-compose.yaml (nablr_transfers).
# Apply the schema with: make migrate-transfers
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nablr_transfers?sslmode=disable

RABBITMQ_URL=
# Shared broker. Docker Compose: amqp://nabla:nabla123@rabbitmq:5672/

OTEL_EXPORTER_OTLP_ENDPOINT=
# OTLP/HTTP collector endpoint. Leave empty to disable trace and metric export.

# ---------------------------------------------------------------------------
# Listeners
# ---------------------------------------------------------------------------
# REST is the external transport (Mobile/Web -> API Gateway -> here, and Postman
# for local testing). gRPC is the internal service-to-service transport.
TRANSFERS_HTTP_ADDRESS=:8002
TRANSFERS_GRPC_ADDRESS=:9002

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# JWT_SECRET is required — the service refuses to boot without it (Validate()).
# Tokens are minted by identity-svc; the "sub" claim is the user_id that this
# service keys every wallet, transfer and limit on.
JWT_SECRET=your-jwt-secret-here
JWT_ISSUER=nabla

# Shared secret for inbound internal gRPC calls, checked as x-service-auth.
API_SECRET=secret

IDENTITY_GRPC_URL=localhost:9001
# Docker/sandbox private-network example: identity-svc:9001

NOTIFICATION_GRPC_URL=localhost:9004
# Docker/sandbox private-network example: notification-svc:9004

INTERNAL_SERVICE_TOKEN=
# Must match notification-svc INTERNAL_SERVICE_TOKEN.

# ---------------------------------------------------------------------------
# Webhook verification
# ---------------------------------------------------------------------------
# Local/mock payout callbacks use HMAC over "<timestamp>.<body>". Real Novac
# callbacks use NOVAC_WEBHOOK_ALLOWED_IPS below and are verified against Novac
# before any wallet or transfer state is changed.
WEBHOOK_SECRET=webhook-secret-change-in-prod
PAYOUT_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Field encryption (both hex-encoded)
# ---------------------------------------------------------------------------
# Account numbers are never stored in plaintext: the AES-256-GCM ciphertext is
# the only copy, and the blind index backs the uniqueness constraint.
# Leave both empty in development and an ephemeral key is generated at boot;
# in production both MUST be set or beneficiary data is unreadable after restart.
ENCRYPTION_KEY=
BLIND_INDEX_KEY=

# ---------------------------------------------------------------------------
# Payout rail
# ---------------------------------------------------------------------------
# With neither NOVAC_API_KEY nor NOVAC_API_SECRET set, the service and worker
# both fall back to the in-process mock rail, which delivers settle/fail
# callbacks locally so the whole dispatch path is exercisable without a network.
NOVAC_API_URL=https://api.novacpayment.com
NOVAC_API_KEY=
NOVAC_API_SECRET=
NOVAC_WEBHOOK_ALLOWED_IPS=18.233.137.110
# Enable only when Nginx/load balancer overwrites X-Real-IP and
# X-Forwarded-For. Never trust client-supplied forwarding headers directly.
NOVAC_WEBHOOK_TRUST_PROXY_HEADERS=false

# ---------------------------------------------------------------------------
# Admin API (operator-only wallet funding)
# ---------------------------------------------------------------------------
# Gates POST /admin/wallet/fund, checked as the X-Admin-Api-Key header.
# Left empty, the /admin/* routes are not mounted at all. Must match the
# ADMIN_API_KEY configured on api-gateway, which proxies to this endpoint.
ADMIN_API_KEY=
